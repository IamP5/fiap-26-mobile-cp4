rules_version = '2';

// Cloud Firestore: profiles, directory, groups, direct conversations and
// push devices. Messages live in the Realtime Database (database.rules.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMillis(value) {
      return value is int && value > 0;
    }

    // Only a URL can be stored for photos (never Base64): '' = default image.
    function isPhotoUrl(value) {
      return value is string && value.size() <= 2048
        && (value == '' || value.matches('https://.+'));
    }

    function isName(value) {
      return value is string && value.size() >= 1 && value.size() <= 80;
    }

    // ---- Directory: what any signed-in user can see about others ----------
    // Just name + photo, to list users and render chats. Registration data
    // (e-mail, phone, birth date) is in users/{uid}, which is private.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'photoUrl', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'nameLower', 'photoUrl', 'updatedAt'])
        && isName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && isPhotoUrl(request.resource.data.photoUrl)
        && isMillis(request.resource.data.updatedAt);
      allow delete: if false;
    }

    // ---- Private profile -----------------------------------------------------
    // Only the owner reads it directly. Other users get it through the API
    // (GET /profiles/{uid}), which first checks for a shared conversation or
    // group with the Admin SDK.
    match /users/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
          && d.keys().hasAll(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
          && isName(d.name)
          && d.phoneNumber is string && d.phoneNumber.matches('[+]?[0-9]{10,15}')
          && d.birthDate is string && d.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && isPhotoUrl(d.photoUrl)
          && isMillis(d.createdAt);
      }

      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validProfile()
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid) && validProfile()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Push tokens: never readable by other users. The API reads them with
      // the Admin SDK to send notifications.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && deviceId.matches('[A-Za-z0-9-]{8,64}')
          && request.resource.data.keys().hasOnly(['token', 'platform', 'enabled', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'platform', 'enabled', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.enabled is bool
          && isMillis(request.resource.data.updatedAt);
      }
    }

    // ---- Groups ----------------------------------------------------------------
    // Only active members read a group. Every write goes through the API: it
    // enforces owner-only management and memberLimit inside a Firestore
    // transaction (safe under concurrent additions) and keeps the Realtime
    // Database membership mirror in sync, which rules cannot do.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // ---- Direct conversations ----------------------------------------------------
    // Id = the two uids sorted and joined by '_', so a pair can only ever have
    // one conversation, and the conversation always has exactly two members.
    match /directConversations/{conversationId} {
      // get works before the document exists (the id names the members), so
      // the app can check-then-create; list requires array-contains on self.
      allow get: if signedIn() && request.auth.uid in conversationId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[1]))
        && isMillis(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Idempotency log of the push API (Admin SDK only).
    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
    }
  }
}
