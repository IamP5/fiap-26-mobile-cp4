# API (server/) — copy to .env only for local runs. On Cloud Run these are set
# by deploy.sh; real secrets never go in this file or in git.
PORT=8080
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=seu-project-id.firebasestorage.app

# Optional. Leave EMPTY on Cloud Run: the service runs as a dedicated service
# account (Application Default Credentials), so no private key exists at all.
# Only for hosts without workload identity — set them as secrets there.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local development against the Firebase Emulator Suite (optional).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000?ns=seu-project-id-default-rtdb
