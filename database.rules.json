{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid) || root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)",
        ".indexOn": ["createdAt"],

        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && ($conversationId.matches(/^[A-Za-z0-9]{1,128}_[A-Za-z0-9]{1,128}$/) && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) || root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['conversationType', 'senderId', 'text', 'target', 'createdAt'])",

          "conversationType": {
            ".validate": "(newData.val() === 'direct' && $conversationId.matches(/^[A-Za-z0-9]{1,128}_[A-Za-z0-9]{1,128}$/)) || (newData.val() === 'group' && root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)"
          },
          "senderId": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "target": {
            ".validate": "newData.child('type').val() === 'conversation' ? !newData.hasChild('memberId') : (newData.child('type').val() === 'member' && newData.hasChild('memberId'))",
            "type": {
              ".validate": "newData.isString()"
            },
            "memberId": {
              ".validate": "newData.isString() && newData.val() !== auth.uid && ($conversationId === auth.uid + '_' + newData.val() || $conversationId === newData.val() + '_' + auth.uid || root.child('groupMembers').child($conversationId).child(newData.val()).val() === true)"
            },
            "$other": {
              ".validate": false
            }
          },
          "mentionedUserIds": {
            "$uid": {
              ".validate": "newData.val() === true && $uid !== auth.uid && root.child('groupMembers').child($conversationId).child($uid).val() === true"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "groupMembers": {
      "$groupId": {
        ".read": "auth != null && data.child(auth.uid).val() === true"
      }
    },

    "readMarks": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid) || root.child('groupMembers').child($conversationId).child(auth.uid).val() === true)",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    }
  }
}
